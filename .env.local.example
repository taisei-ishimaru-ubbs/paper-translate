# Copy this file to .env.local (gitignored) and fill in real values.
# scripts/translate-papers-daemon.sh sources .env.local if present.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Markdown translation (translate_markdown.py, via LiteLLM). At least one of
# OPENAI_API_KEY / GEMINI_API_KEY must be set; translation falls back
# openai -> gemini so a single provider outage/rate limit doesn't stall.
OPENAI_API_KEY=
OPENAI_ADMIN_API_KEY=
TRANSLATE_MODEL=openai/gpt-5.6-terra
TRANSLATE_FALLBACK_MODEL=gemini/gemini-3.1-flash-lite
OPENAI_DAILY_TOKEN_LIMIT=2400000
# Optional: defaults to ~/.local/state/ubbs/paper-translate-openai-quota.json
# OPENAI_DAILY_QUOTA_STATE=
